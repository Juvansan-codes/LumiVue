# =============================================================================
# LumiVue — Frontend Environment Variables
# =============================================================================

# FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "false" to use real backend API and real Supabase database
NEXT_PUBLIC_USE_MOCK=false

# Supabase Database & Storage Configuration
# Find these in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Auth — Redirect URL
# Set this to your deployed domain or localhost for development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
