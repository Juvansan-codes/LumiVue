# ---- Backend Environment ----
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ---- MedGemma Configuration ----
# Set to "mock" for development without a real model
MEDGEMMA_MODE=mock
MEDGEMMA_API_URL=
MEDGEMMA_API_KEY=

# ---- Model Paths ----
MODEL_PATH=models/lumivue_densenet121_rsna.pth
