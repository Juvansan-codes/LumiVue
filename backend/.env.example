# ---- Backend Environment ----
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# ---- MedGemma Configuration ----
# Modes:
#   mock   — placeholder responses, no GPU required (default for development)
#   remote — call the MedGemma laptop service over LAN (Phase 6B production)
#   api    — call an external hosted API
#   local  — load MedGemma in-process (not used in Phase 6B)
MEDGEMMA_MODE=mock

# When MEDGEMMA_MODE=remote, set this to the MedGemma laptop's LAN IP.
# Do NOT commit the real IP — set it only in your local .env file.
# Example: MEDGEMMA_BASE_URL=http://192.168.1.25:8001
MEDGEMMA_BASE_URL=

# Timeout in seconds for calls to the remote MedGemma service (default 120)
MEDGEMMA_TIMEOUT=120

# Legacy / external API settings (not used in Phase 6B)
MEDGEMMA_API_URL=
MEDGEMMA_API_KEY=

# ---- Model Paths ----
MODEL_PATH=models/lumivue_densenet121_rsna.pth
